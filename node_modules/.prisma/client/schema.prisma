generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  OPERATOR_AGENT
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  INITIATED
  HOLD_REQUESTED
  HELD
  HOLD_FAILED
  HOLD_EXPIRED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  BOOKING_REQUESTED
  CONFIRMED
  BOOKING_UNKNOWN
  BOOKING_FAILED
  CANCELLATION_REQUESTED
  CANCELLED
  CANCELLATION_FAILED
  REFUND_PENDING
  REFUNDED
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  TIMED_OUT
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CancellationStatus {
  REQUESTED
  COMPLETED
  FAILED
  REJECTED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum RefundDestination {
  ORIGINAL_PAYMENT_METHOD
  WALLET
}

enum TicketStatus {
  ISSUED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  REFUND_PROCESSED
  PAYMENT_REMINDER
  TRIP_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  REVERSAL
}

enum IdempotencyStatus {
  PROCESSING
  RESOLVED
  FAILED
}

// ---------------------------------------------------------------------------
// B2B Agent Enums
// ---------------------------------------------------------------------------

enum AgentStatus {
  PENDING_KYC
  KYC_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgentKycDocType {
  PAN_CARD
  GST_CERTIFICATE
  BUSINESS_REGISTRATION
  BANK_STATEMENT
  OWNER_IDENTITY
  CANCELLED_CHEQUE
}

enum AgentStaffRole {
  OWNER
  MANAGER
  BOOKING_AGENT
  ACCOUNTANT
  VIEWER
}

enum LedgerEntryType {
  AGENT_WALLET_DEBIT
  AGENT_WALLET_CREDIT
  AGENT_WALLET_TOPUP
  COMMISSION_CREDIT
  COMMISSION_REVERSAL
  REFUND_CREDIT
  CONVENIENCE_FEE_DEBIT
  CREDIT_LIMIT_UTILIZATION
  CREDIT_LIMIT_RELEASE
  PLATFORM_REVENUE_CREDIT
  MANUAL_ADJUSTMENT
}

enum CommissionRuleType {
  FLAT_PERCENTAGE
  FLAT_AMOUNT
  TIERED_BOOKING
  OPERATOR_SPECIFIC
  ROUTE_SPECIFIC
}

enum TopupStatus {
  INITIATED
  PAYMENT_PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  walletBalance Decimal    @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  bookings           Booking[]
  seatHolds          SeatHold[]
  payments           Payment[]
  cancellations      Cancellation[]
  refunds            Refund[]
  walletTransactions WalletTransaction[]
  agentStaff         AgentStaff[] // B2B: agent org memberships

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model City {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  state          String?
  providerCityId Int?     @map("provider_city_id")
  providerName   String   @default("GDS") @map("provider_name")
  aliases        Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([providerName, providerCityId])
  @@index([name])
  @@map("cities")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String?       @map("user_id") @db.Uuid
  agentId            String?       @map("agent_id") @db.Uuid // B2B: tenant isolation
  userType           String        @default("CUSTOMER") @map("user_type") // "CUSTOMER" | "AGENT"
  bookingNumber      String        @unique @map("booking_number")
  status             BookingStatus @default(INITIATED)
  providerName       String        @default("GDS") @map("provider_name")
  providerHoldId     String?       @map("provider_hold_id")
  providerTicketNo   String?       @map("provider_ticket_no")
  providerPnrNo      String?       @map("provider_pnr_no")
  fromCityId         Int           @map("from_city_id")
  toCityId           Int           @map("to_city_id")
  fromCityName       String        @map("from_city_name")
  toCityName         String        @map("to_city_name")
  journeyDate        String        @map("journey_date") // yyyy-mm-dd
  busId              Int           @map("bus_id")
  tripId             String        @map("trip_id")
  pickupCode         String        @map("pickup_code")
  pickupLocation     String        @map("pickup_location")
  pickupTime         String        @map("pickup_time")
  dropoffCode        String        @map("dropoff_code")
  dropoffLocation    String        @map("dropoff_location")
  dropoffTime        String        @map("dropoff_time")
  operatorName       String        @map("operator_name")
  busType            String        @map("bus_type")
  totalFare          Decimal       @map("total_fare") @db.Decimal(10, 2)
  baseFare           Decimal       @map("base_fare") @db.Decimal(10, 2)
  serviceTax         Decimal       @map("service_tax") @db.Decimal(10, 2)
  operatorGst        Decimal       @default(0.00) @map("operator_gst") @db.Decimal(10, 2)
  convenienceFee     Decimal       @default(0.00) @map("convenience_fee") @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  contactName        String        @map("contact_name")
  contactEmail       String        @map("contact_email")
  contactPhone       String        @map("contact_phone")
  cancellationPolicy Json?         @map("cancellation_policy")
  pickupSnapshot     Json?         @map("pickup_snapshot")
  dropoffSnapshot    Json?         @map("dropoff_snapshot")
  version            Int           @default(1)
  idempotencyKey     String?       @unique @map("idempotency_key")
  confirmedAt        DateTime?     @map("confirmed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent                Agent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  seats                BookingSeat[]
  passengers           BookingPassenger[]
  payments             Payment[]
  holds                SeatHold[]
  cancellations        Cancellation[]
  refunds              Refund[]
  ticket               Ticket?
  providerTransactions ProviderTransaction[]
  notifications        Notification[]
  commissionSnapshot   CommissionSnapshot?
  ledgerEntries        LedgerEntry[]

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([providerHoldId])
  @@index([providerTicketNo])
  @@index([journeyDate])
  @@map("bookings")
}

model BookingSeat {
  id         String  @id @default(uuid()) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  seatNo     String  @map("seat_no")
  seatTypeId Int     @map("seat_type_id")
  fareTotal  Decimal @map("fare_total") @db.Decimal(10, 2)
  fareBase   Decimal @map("fare_base") @db.Decimal(10, 2)
  fareTax    Decimal @map("fare_tax") @db.Decimal(10, 2)
  deck       Int     @default(1)
  row        Int     @default(0)
  column     Int     @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatNo])
  @@index([bookingId])
  @@map("booking_seats")
}

model BookingPassenger {
  id         String  @id @default(uuid()) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  name       String
  age        Int
  gender     String // M or F
  seatNo     String  @map("seat_no")
  fare       Decimal @db.Decimal(10, 2)
  seatTypeId Int     @map("seat_type_id")
  isAcSeat   Boolean @default(false) @map("is_ac_seat")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatNo])
  @@index([bookingId])
  @@map("booking_passengers")
}

model SeatHold {
  id             String     @id @default(uuid()) @db.Uuid
  bookingId      String?    @map("booking_id") @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  providerHoldId String     @map("provider_hold_id")
  providerName   String     @default("GDS") @map("provider_name")
  status         HoldStatus @default(ACTIVE)
  fromCityId     Int        @map("from_city_id")
  toCityId       Int        @map("to_city_id")
  journeyDate    String     @map("journey_date")
  busId          Int        @map("bus_id")
  seats          Json
  expiresAt      DateTime   @map("expires_at")
  releasedAt     DateTime?  @map("released_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([providerName, providerHoldId])
  @@index([expiresAt, status])
  @@index([bookingId])
  @@map("seat_holds")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  gateway          String        @default("PHONEPE")
  paymentMethod    String?       @map("payment_method")
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  gatewaySignature String?       @map("gateway_signature")
  merchantTxnId    String        @unique @map("merchant_txn_id")
  webhookVerified  Boolean       @default(false) @map("webhook_verified")
  idempotencyKey   String?       @unique @map("idempotency_key")
  attempts         Int           @default(1)
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Cancellation {
  id                  String             @id @default(uuid()) @db.Uuid
  bookingId           String             @map("booking_id") @db.Uuid
  userId              String?            @map("user_id") @db.Uuid
  status              CancellationStatus @default(REQUESTED)
  seatNos             String[]           @map("seat_nos")
  providerNewHoldId   String?            @map("provider_new_hold_id")
  providerNewTicketNo String?            @map("provider_new_ticket_no")
  providerNewPnrNo    String?            @map("provider_new_pnr_no")
  chargePct           Decimal            @map("charge_pct") @db.Decimal(5, 2)
  chargeAmt           Decimal            @map("charge_amt") @db.Decimal(10, 2)
  refundAmount        Decimal            @map("refund_amount") @db.Decimal(10, 2)
  totalFare           Decimal            @map("total_fare") @db.Decimal(10, 2)
  reason              String?
  idempotencyKey      String?            @unique @map("idempotency_key")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([bookingId])
  @@map("cancellations")
}

model Refund {
  id                String            @id @default(uuid()) @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  paymentId         String?           @map("payment_id") @db.Uuid
  cancellationId    String?           @map("cancellation_id") @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  amount            Decimal           @db.Decimal(10, 2)
  status            RefundStatus      @default(PENDING)
  destination       RefundDestination @default(ORIGINAL_PAYMENT_METHOD)
  reason            String
  gatewayRefundId   String?           @map("gateway_refund_id")
  providerRefundRef String?           @map("provider_refund_ref")
  retryCount        Int               @default(0) @map("retry_count")
  idempotencyKey    String?           @unique @map("idempotency_key")
  completedAt       DateTime?         @map("completed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  cancellation Cancellation? @relation(fields: [cancellationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @map("booking_id") @db.Uuid
  ticketNumber    String       @unique @map("ticket_number")
  pnrNumber       String       @map("pnr_number")
  status          TicketStatus @default(ISSUED)
  pdfUrl          String?      @map("pdf_url")
  storageKey      String?      @map("storage_key")
  bookingSnapshot Json         @map("booking_snapshot")
  generatedAt     DateTime     @default(now()) @map("generated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([ticketNumber])
  @@index([pnrNumber])
  @@map("tickets")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @unique @map("event_id")
  gateway         String
  eventType       String    @map("event_type")
  payload         Json
  signature       String?
  verified        Boolean   @default(false)
  processed       Boolean   @default(false)
  processingError String?   @map("processing_error")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([gateway, eventType])
  @@index([processed])
  @@map("webhook_events")
}

model ProviderTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String?  @map("booking_id") @db.Uuid
  providerName    String   @default("GDS") @map("provider_name")
  operation       String
  requestPayload  Json?    @map("request_payload")
  responsePayload Json?    @map("response_payload")
  responseStatus  Int?     @map("response_status")
  durationMs      Int      @map("duration_ms")
  errorMessage    String?  @map("error_message")
  requestId       String   @map("request_id")
  createdAt       DateTime @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([providerName, operation])
  @@index([requestId])
  @@map("provider_transactions")
}

model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(10, 2)
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(10, 2)
  referenceType  String                @map("reference_type")
  referenceId    String?               @map("reference_id")
  description    String?
  idempotencyKey String?               @unique @map("idempotency_key")
  createdAt      DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_transactions")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @map("user_id") @db.Uuid
  bookingId  String?             @map("booking_id") @db.Uuid
  channel    NotificationChannel
  type       NotificationType
  status     NotificationStatus  @default(PENDING)
  recipient  String
  payload    Json
  retryCount Int                 @default(0) @map("retry_count")
  sentAt     DateTime?           @map("sent_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  actorType    String   @default("SYSTEM") @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String            @id @default(uuid()) @db.Uuid
  key          String            @unique
  userId       String?           @map("user_id")
  method       String
  path         String
  requestHash  String            @map("request_hash")
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  status       IdempotencyStatus @default(PROCESSING)
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([key, status])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Admin Module — Enums
// ---------------------------------------------------------------------------

enum OperatorStatus {
  ACTIVE
  SUSPENDED
  PENDING_REVIEW
  DEACTIVATED
}

enum CouponType {
  PERCENTAGE
  FLAT
  CASHBACK
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  DISABLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SystemConfigType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ---------------------------------------------------------------------------
// Admin Module — Models
// ---------------------------------------------------------------------------

model Operator {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  code               String         @unique
  contactEmail       String         @map("contact_email")
  contactPhone       String         @map("contact_phone")
  status             OperatorStatus @default(ACTIVE)
  providerName       String         @default("GDS") @map("provider_name")
  providerOperatorId String?        @map("provider_operator_id")
  commissionPct      Decimal        @default(0.00) @map("commission_pct") @db.Decimal(5, 2)
  gstNumber          String?        @map("gst_number")
  panNumber          String?        @map("pan_number")
  address            String?
  city               String?
  state              String?
  metadata           Json?
  totalBookings      Int            @default(0) @map("total_bookings")
  totalRevenue       Decimal        @default(0.00) @map("total_revenue") @db.Decimal(14, 2)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("operators")
}

model Coupon {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  type                CouponType
  value               Decimal      @db.Decimal(10, 2)
  maxDiscount         Decimal?     @map("max_discount") @db.Decimal(10, 2)
  minOrderValue       Decimal?     @map("min_order_value") @db.Decimal(10, 2)
  status              CouponStatus @default(ACTIVE)
  description         String?
  termsAndConditions  String?      @map("terms_and_conditions")
  usageLimit          Int?         @map("usage_limit")
  usageLimitPerUser   Int?         @map("usage_limit_per_user")
  usedCount           Int          @default(0) @map("used_count")
  applicableRoutes    Json?        @map("applicable_routes")
  applicableOperators Json?        @map("applicable_operators")
  validFrom           DateTime     @map("valid_from")
  validUntil          DateTime     @map("valid_until")
  createdBy           String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@index([code])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  discount  Decimal  @db.Decimal(10, 2)
  appliedAt DateTime @default(now()) @map("applied_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model SupportTicket {
  id           String                @id @default(uuid()) @db.Uuid
  ticketNumber String                @unique @map("ticket_number")
  userId       String?               @map("user_id") @db.Uuid
  bookingId    String?               @map("booking_id") @db.Uuid
  subject      String
  description  String
  category     String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assignedTo   String?               @map("assigned_to") @db.Uuid
  resolvedAt   DateTime?             @map("resolved_at")
  closedAt     DateTime?             @map("closed_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  replies SupportTicketReply[]

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([assignedTo])
  @@index([priority])
  @@map("support_tickets")
}

model SupportTicketReply {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorType String   @map("author_type")
  message    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_replies")
}

model SystemConfig {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  value       String
  type        SystemConfigType @default(STRING)
  description String?
  group       String           @default("general")
  isSecret    Boolean          @default(false) @map("is_secret")
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([group])
  @@map("system_configs")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AdminActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @map("admin_id") @db.Uuid
  action       String
  module       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ---------------------------------------------------------------------------
// B2B Agent Models
// ---------------------------------------------------------------------------

model Agent {
  id                String      @id @default(uuid()) @db.Uuid
  businessName      String      @map("business_name")
  contactPersonName String      @map("contact_person_name")
  email             String      @unique
  phone             String
  businessAddress   String      @map("business_address")
  city              String
  state             String
  pincode           String?
  logoUrl           String?     @map("logo_url")
  gstNumber         String?     @map("gst_number")
  panNumber         String?     @map("pan_number")
  status            AgentStatus @default(PENDING_KYC)
  rejectionReason   String?     @map("rejection_reason")
  approvedAt        DateTime?   @map("approved_at")
  approvedBy        String?     @map("approved_by") @db.Uuid
  suspendedAt       DateTime?   @map("suspended_at")
  suspendedReason   String?     @map("suspended_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  kycDocuments        AgentKycDocument[]
  wallet              AgentWallet?
  staff               AgentStaff[]
  bookings            Booking[]
  ledgerEntries       LedgerEntry[]
  bankAccounts        AgentBankAccount[]
  commissionRules     CommissionRule[]
  commissionSnapshots CommissionSnapshot[]
  walletTopups        WalletTopup[]

  @@index([status])
  @@index([email])
  @@map("agents")
}

model AgentKycDocument {
  id           String          @id @default(uuid()) @db.Uuid
  agentId      String          @map("agent_id") @db.Uuid
  docType      AgentKycDocType @map("doc_type")
  fileUrl      String          @map("file_url")
  storageKey   String          @map("storage_key")
  verifiedAt   DateTime?       @map("verified_at")
  verifiedBy   String?         @map("verified_by") @db.Uuid
  rejectedAt   DateTime?       @map("rejected_at")
  rejectReason String?         @map("reject_reason")
  createdAt    DateTime        @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, docType])
  @@index([agentId])
  @@map("agent_kyc_documents")
}

model AgentBankAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  agentId             String    @map("agent_id") @db.Uuid
  accountHolderName   String    @map("account_holder_name")
  accountNumber       String    @map("account_number")
  ifscCode            String    @map("ifsc_code")
  bankName            String    @map("bank_name")
  isVerified          Boolean   @default(false) @map("is_verified")
  isPrimary           Boolean   @default(false) @map("is_primary")
  verifiedAt          DateTime? @map("verified_at")
  withdrawFreezeUntil DateTime? @map("withdraw_freeze_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_bank_accounts")
}

model AgentStaff {
  id          String         @id @default(uuid()) @db.Uuid
  agentId     String         @map("agent_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        AgentStaffRole @default(BOOKING_AGENT)
  permissions Json?
  isActive    Boolean        @default(true) @map("is_active")
  invitedAt   DateTime       @default(now()) @map("invited_at")
  joinedAt    DateTime?      @map("joined_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([userId])
  @@map("agent_staff")
}

// ---------------------------------------------------------------------------
// Agent Wallet & Double-Entry Ledger
// ---------------------------------------------------------------------------

model AgentWallet {
  id              String    @id @default(uuid()) @db.Uuid
  agentId         String    @unique @map("agent_id") @db.Uuid
  cashBalance     Decimal   @default(0) @map("cash_balance") @db.Decimal(14, 4)
  creditLimit     Decimal   @default(0) @map("credit_limit") @db.Decimal(14, 4)
  creditUsed      Decimal   @default(0) @map("credit_used") @db.Decimal(14, 4)
  isFrozen        Boolean   @default(false) @map("is_frozen")
  frozenReason    String?   @map("frozen_reason")
  frozenAt        DateTime? @map("frozen_at")
  frozenBy        String?   @map("frozen_by") @db.Uuid
  totalTopups     Decimal   @default(0) @map("total_topups") @db.Decimal(14, 4)
  totalSpent      Decimal   @default(0) @map("total_spent") @db.Decimal(14, 4)
  totalCommission Decimal   @default(0) @map("total_commission") @db.Decimal(14, 4)
  totalRefunds    Decimal   @default(0) @map("total_refunds") @db.Decimal(14, 4)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_wallets")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @map("batch_id")
  agentId        String?         @map("agent_id") @db.Uuid
  bookingId      String?         @map("booking_id") @db.Uuid
  cancellationId String?         @map("cancellation_id") @db.Uuid
  refundId       String?         @map("refund_id") @db.Uuid
  topupId        String?         @map("topup_id") @db.Uuid
  type           LedgerEntryType
  debitAmount    Decimal         @default(0) @map("debit_amount") @db.Decimal(14, 4)
  creditAmount   Decimal         @default(0) @map("credit_amount") @db.Decimal(14, 4)
  currency       String          @default("INR")
  description    String
  referenceId    String?         @map("reference_id")
  idempotencyKey String?         @unique @map("idempotency_key")
  postedAt       DateTime        @default(now()) @map("posted_at")
  createdBy      String?         @map("created_by")

  agent   Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([bookingId])
  @@index([batchId])
  @@index([type])
  @@index([postedAt])
  @@map("ledger_entries")
}

model WalletTopup {
  id               String      @id @default(uuid()) @db.Uuid
  agentId          String      @map("agent_id") @db.Uuid
  amount           Decimal     @db.Decimal(10, 2)
  status           TopupStatus @default(INITIATED)
  gateway          String      @default("RAZORPAY")
  merchantTxnId    String      @unique @map("merchant_txn_id")
  gatewayOrderId   String?     @map("gateway_order_id")
  gatewayPaymentId String?     @map("gateway_payment_id")
  webhookVerified  Boolean     @default(false) @map("webhook_verified")
  idempotencyKey   String?     @unique @map("idempotency_key")
  completedAt      DateTime?   @map("completed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@map("wallet_topups")
}

// ---------------------------------------------------------------------------
// Commission Engine
// ---------------------------------------------------------------------------

model CommissionRule {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  ruleType       CommissionRuleType @map("rule_type")
  agentId        String?            @map("agent_id") @db.Uuid
  operatorName   String?            @map("operator_name")
  fromCityId     Int?               @map("from_city_id")
  toCityId       Int?               @map("to_city_id")
  percentage     Decimal?           @db.Decimal(6, 4)
  flatAmount     Decimal?           @map("flat_amount") @db.Decimal(10, 2)
  minFare        Decimal?           @map("min_fare") @db.Decimal(10, 2)
  maxCommission  Decimal?           @map("max_commission") @db.Decimal(10, 2)
  priority       Int                @default(0)
  effectiveFrom  DateTime           @map("effective_from")
  effectiveUntil DateTime?          @map("effective_until")
  isActive       Boolean            @default(true) @map("is_active")
  createdBy      String             @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([isActive, effectiveFrom, effectiveUntil])
  @@index([priority])
  @@map("commission_rules")
}

model CommissionSnapshot {
  id                    String    @id @default(uuid()) @db.Uuid
  bookingId             String    @unique @map("booking_id") @db.Uuid
  agentId               String    @map("agent_id") @db.Uuid
  ruleId                String?   @map("rule_id") @db.Uuid
  ruleSnapshot          Json      @map("rule_snapshot")
  grossFare             Decimal   @map("gross_fare") @db.Decimal(14, 4)
  baseFareForCommission Decimal   @map("base_fare_for_commission") @db.Decimal(14, 4)
  commissionRate        Decimal   @map("commission_rate") @db.Decimal(8, 4)
  commissionAmt         Decimal   @map("commission_amt") @db.Decimal(10, 2)
  netFare               Decimal   @map("net_fare") @db.Decimal(14, 4)
  reversedAt            DateTime? @map("reversed_at")
  reversalAmt           Decimal?  @map("reversal_amt") @db.Decimal(10, 2)
  createdAt             DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([createdAt])
  @@map("commission_snapshots")
}

// ---------------------------------------------------------------------------
// Payment Gateway Orchestration & Multi-PG Management
// ---------------------------------------------------------------------------

model PaymentGatewayConfig {
  id                  String    @id @default(uuid()) @db.Uuid
  gateway             String    @unique // "RAZORPAY", "PHONEPE"
  name                String // "Razorpay Payments", "PhonePe Standard Checkout"
  isEnabled           Boolean   @default(true) @map("is_enabled")
  isPrimary           Boolean   @default(false) @map("is_primary")
  priority            Int       @default(1)
  supportedMethods    String[]  @default(["UPI", "CARD", "NETBANKING", "WALLET"]) @map("supported_methods")
  mode                String    @default("LIVE") // "LIVE", "TEST", "MAINTENANCE"
  trafficWeight       Int       @default(100) @map("traffic_weight") // 0 to 100 percentage
  failureThresholdPct Int       @default(15) @map("failure_threshold_pct")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  isHealthy           Boolean   @default(true) @map("is_healthy")
  lastHealthCheck     DateTime? @map("last_health_check")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("payment_gateway_configs")
}
