# ==============================================================================
# AiBus Backend Application Environment Configuration
# Use this template for local development (.env) and Render production deployment
# ==============================================================================

# Application Configuration
NODE_ENV=production
# Note: On Render, PORT is dynamically assigned (typically 10000); default 3000 for local
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
APP_NAME=aibus-backend
LOG_LEVEL=info

# CORS Settings (comma-separated origins allowed to make API requests)
# Example: https://aibus-client.onrender.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# JWT Secrets (Minimum 32 characters each - generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=replace_with_aibus_secure_jwt_access_secret_32chars_min
JWT_REFRESH_SECRET=replace_with_aibus_secure_jwt_refresh_secret_32chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=aibus

# Database (Supabase / PostgreSQL connection string)
# Production recommendation for Supabase: Use transaction connection pooler (port 6543)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibus_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Used for caching, seat locks, and BullMQ queues)
# For cloud Redis (Render Redis, Upstash, Redis Cloud):
# Upstash example: rediss://default:PASSWORD@endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# Set REDIS_TLS=true when connecting to cloud Redis using SSL/TLS (automatic with rediss://)
REDIS_TLS=false
REDIS_KEY_PREFIX=aibus:

# BullMQ Prefix
BULL_PREFIX=bull

# Mantis GDS Provider Configuration
GDS_PARTNER_BASE_URL=https://partnerapi.iamgds.com
GDS_TRANSACTION_BASE_URL=https://partnertranapi.iamgds.com
GDS_CLIENT_ID=50
GDS_CLIENT_SECRET=replace_with_your_gds_client_secret
GDS_REQUEST_TIMEOUT_MS=15000
GDS_CONNECT_TIMEOUT_MS=5000

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=MOCK_MERCHANT_ID
PHONEPE_CLIENT_ID=MOCK_CLIENT_ID
PHONEPE_CLIENT_SECRET=MOCK_CLIENT_SECRET
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_CALLBACK_URL=http://localhost:3000/api/v1/payments/webhook
PHONEPE_REDIRECT_URL=http://localhost:3000/api/v1/payments/redirect

# Razorpay Payment Gateway (Live credentials supported)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Payment Orchestration & Smart Routing
PAYMENT_PRIMARY_GATEWAY=RAZORPAY
PAYMENT_HOLD_CUTOFF_SECONDS=90

# Cloudinary (Optional image storage)
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# SMS OTP Service (Dreamz Technology DLT Gateway)
SMS_GATEWAY_URL=http://trans.dreamztechnolgy.org/smsstatuswithid.aspx
SMS_GATEWAY_MOBILE=9923400506
SMS_GATEWAY_PASSWORD=WorknAi@2
SMS_GATEWAY_APIKEY=76bda706af0d42b5a7ea8a615567ad4f
SMS_GATEWAY_PEID=1701176380063580392
SMS_GATEWAY_TEMPLATE_ID=1777179197804384361
SMS_GATEWAY_SENDER_ID=PGINF
SMS_DEFAULT_APP_HASH=AbCdEfGhIjK
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_LENGTH=6
SMS_SIMULATE=false

# Security
BCRYPT_ROUNDS=12
REQUEST_BODY_LIMIT=1mb

# Seat Lock & Hold TTLs (Seconds)
SEAT_HOLD_TTL_SECONDS=600
SEAT_LOCK_TTL_SECONDS=30
SHUTDOWN_TIMEOUT_MS=15000
