# ==============================================================================
# AiBus Backend — Production Environment Template for AWS EC2
# Copy this file to .env on your EC2 instance (/var/www/express-app/.env)
# ==============================================================================

# Application Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
APP_NAME=aibus-backend
LOG_LEVEL=info

# CORS Settings (comma-separated origins allowed to make API requests)
# Replace YOUR_EC2_PUBLIC_IP_OR_DOMAIN and add your production frontend domains
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN,https://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

# JWT Secrets (Minimum 32 characters each)
JWT_ACCESS_SECRET=aibus_super_secret_access_jwt_key_32chars_long_2026_prod
JWT_REFRESH_SECRET=aibus_super_secret_refresh_jwt_key_32chars_long_2026_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=aibus

# Database (Supabase PostgreSQL - Session / Direct connection for EC2)
DATABASE_URL=postgresql://postgres.lxjfzahdxcqlfffdxitq:xs2Y5OOjXw3a4F5y@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & BullMQ Queue Server (Local EC2 Redis)
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=aibus:
BULL_PREFIX=bull

# Mantis GDS Provider Configuration
GDS_PARTNER_BASE_URL=https://partnerapi.iamgds.com
GDS_TRANSACTION_BASE_URL=https://partnertranapi.iamgds.com
GDS_CLIENT_ID=50
GDS_CLIENT_SECRET=d66de12fa3473a93415b02494253f088
GDS_REQUEST_TIMEOUT_MS=15000
GDS_CONNECT_TIMEOUT_MS=5000

# PhonePe Payment Gateway (Sandbox Configuration)
PHONEPE_MERCHANT_ID=M23XTGBCAO55H
PHONEPE_CLIENT_ID=M23XTGBCAO55H_2610091736
PHONEPE_CLIENT_SECRET=OTNhYTFlNjYtNjY1Mi00YzlmLWJiZDQtZDg5YmVhMWQyNWQz
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_CALLBACK_URL=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN/api/v1/payments/webhook
PHONEPE_REDIRECT_URL=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN/api/v1/payments/redirect

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Security & Limits
BCRYPT_ROUNDS=12
REQUEST_BODY_LIMIT=1mb

# Seat Lock & Shutdown Timers (Seconds / Milliseconds)
SEAT_HOLD_TTL_SECONDS=600
SEAT_LOCK_TTL_SECONDS=30
SHUTDOWN_TIMEOUT_MS=15000
